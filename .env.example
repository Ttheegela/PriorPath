# Copy to .env for local development. Never commit real values.
# Production values live in Vercel as Secret environment variables.

# Required
DATABASE_URL=postgresql+psycopg://priorpath:priorpath@localhost:5433/priorpath_test
SESSION_SECRET=dev-secret

# Optional: bearer token for GET /api/internal/cleanup (unset = cleanup returns 401)
CRON_SECRET=

# Optional: AI explanations and PDF extraction (unset = explanations unavailable, PDF uploads return 503)
OPENROUTER_API_KEY=
EXPLAIN_MODEL=deepseek/deepseek-v4-flash
EXTRACT_MODEL=google/gemini-2.5-flash-lite

# Optional: patient pseudonym key (falls back to SESSION_SECRET)
PSEUDONYM_SECRET=

# Optional: 0 turns off seeding demo cases into new workspaces (default on)
PRIORPATH_DEMO=1

# Optional: Langfuse tracing (on only when both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
